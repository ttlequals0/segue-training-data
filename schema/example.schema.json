{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Segue training example (one transcript window)",
  "type": "object",
  "required": ["id", "source", "tier", "prompt", "completion", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["feed", "episode_id", "window"],
      "additionalProperties": false,
      "properties": {
        "feed": {"type": "string"},
        "episode_id": {"type": "string"},
        "window": {"type": "integer", "minimum": 0},
        "total_windows": {"type": "integer", "minimum": 1},
        "license": {"type": "string"},
        "instance": {"type": "string"}
      }
    },
    "tier": {
      "type": "string",
      "enum": ["human_verified", "machine_accepted", "hard_negative", "synthetic"]
    },
    "prompt": {
      "type": "object",
      "required": ["system", "user", "window_start", "window_end"],
      "additionalProperties": false,
      "properties": {
        "system": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "user": {"type": "string", "minLength": 1},
        "window_start": {"type": "number", "minimum": 0},
        "window_end": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "completion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "confidence", "category", "reason", "end_text"],
        "additionalProperties": false,
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "category": {
            "type": "string",
            "enum": ["sponsor", "cross_promo", "self_promo", "interaction"]
          },
          "reason": {"type": "string", "minLength": 1},
          "end_text": {"type": "string", "minLength": 1}
        }
      }
    },
    "teacher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["extracted_at", "extractor_version"],
      "additionalProperties": false,
      "properties": {
        "reviewed": {"type": "boolean"},
        "corrected": {"type": "boolean"},
        "category_source": {"type": "string", "enum": ["original", "backfill_rules", "backfill_llm"]},
        "audio_context_omitted": {"type": "boolean"},
        "extracted_at": {"type": "string"},
        "app_version": {"type": "string"},
        "extractor_version": {"type": "string"},
        "label_fixes": {"type": "array", "items": {"type": "string"}},
        "corrections": {
          "type": "array",
          "items": {"type": "string",
                    "enum": ["confirm", "confirm_trimmed", "auto_confirm",
                             "auto_confirm_trimmed", "false_positive",
                             "boundary_adjustment", "create"]}
        },
        "dropped_spans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "category", "reason", "rule"],
            "additionalProperties": false,
            "properties": {
              "start": {"type": "number"},
              "end": {"type": "number"},
              "category": {"type": "string"},
              "reason": {"type": "string"},
              "rule": {"type": "string",
                       "enum": ["outro_without_show_segments", "audio_only_evidence",
                                "rejected_but_cut"]}
            }
          }
        }
      }
    }
  }
}
